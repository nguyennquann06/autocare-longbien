# Mẫu cấu hình cho docker-compose.yml trên máy EC2.
# Sao chép thành .env rồi điền giá trị. Không commit file .env.

# Tên miền trỏ về IP của máy EC2.
# Không có tên miền thì dùng sslip.io, ví dụ IP 13.250.1.2 -> 13-250-1-2.sslip.io
APP_DOMAIN=

# Tạo bằng: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Tạo mật khẩu bằng: openssl rand -hex 24
DB_DATABASE=autocare_longbien
DB_USERNAME=autocare
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Tài khoản ADMIN được tạo ở lần khởi động đầu tiên.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Để trống GEMINI_API_KEY thì chatbot chạy bằng fallback.
AI_MODE=live
GEMINI_API_KEY=
GEMINI_DAILY_REQUEST_LIMIT=100

# Không bắt buộc, chỉ cần khi demo đăng nhập Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
