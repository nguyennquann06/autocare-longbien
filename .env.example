APP_NAME="AutoCare Long Bien"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12


# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autocare_longbien
DB_USERNAME=root
DB_PASSWORD=


# ----------------------------------------------------------
# SESSION
# ----------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ----------------------------------------------------------
# CACHE / QUEUE / FILESYSTEM
# ----------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=


# ----------------------------------------------------------
# REDIS / MEMCACHED
# ----------------------------------------------------------

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# ----------------------------------------------------------
# MAIL
# ----------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@autocare-longbien.local"
MAIL_FROM_NAME="${APP_NAME}"


# ----------------------------------------------------------
# AWS / STORAGE
# ----------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ----------------------------------------------------------
# GOOGLE OAUTH
# ----------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback


# ----------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"


# ----------------------------------------------------------
# AI / CHATBOT
# ----------------------------------------------------------

AI_PROVIDER=gemini

# Chế độ hoạt động:
# live           = Retrieval + Gemini
# test           = Kiểm thử, không gọi API Gemini thật
# retrieval_only = Chỉ sử dụng nội dung truy xuất
AI_MODE=live


# ----------------------------------------------------------
# GEMINI
# ----------------------------------------------------------

# Không đặt API key thật trong .env.example.
# API key thật chỉ được lưu trong file .env local.
GEMINI_API_KEY=

# Để trống nếu config/ai.php đã có model mặc định.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

GEMINI_TIMEOUT=15
GEMINI_CONNECT_TIMEOUT=5
GEMINI_RETRY_TIMES=2

# Ngưỡng nội bộ để kiểm soát số lần gọi Gemini trong demo.
# Đây không phải tuyên bố về quota chính thức của Google.
GEMINI_DAILY_REQUEST_LIMIT=100